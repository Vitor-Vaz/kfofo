<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8 rounded-2xl bg-gradient-to-r from-zinc-950 via-zinc-900 to-indigo-950 p-6 md:p-8 text-white shadow-xl border border-zinc-800/80">
    <div class="flex items-center gap-3 mb-4">
      <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-gradient-to-tr from-amber-500 to-orange-500 text-white shadow-lg shadow-orange-500/25">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
          />
        </svg>
      </div>
      <div>
        <span class="text-2xl font-black tracking-tight text-white flex items-center gap-1">
          Kfofo<span class="text-orange-400 text-3xl leading-none">.</span>
        </span>
        <p class="text-[11px] font-medium text-zinc-400">O seu agregador inteligente de lares</p>
      </div>
    </div>

    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-white">
      Encontre o seu cantinho ideal
    </h1>
    <p class="mt-2 max-w-2xl text-sm text-zinc-300">
      Pesquise e compare imóveis para morar ou investir nos principais portais do Brasil em uma única experiência.
    </p>

    <form phx-submit="search" class="mt-6">
      <input type="hidden" name="search[state]" value={@search_form["state"]} />
      <input type="hidden" name="search[city]" value={@search_form["city"]} />
      <input type="hidden" name="search[neighborhood]" value={@search_form["neighborhood"]} />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4">
        <div class="relative sm:col-span-2 lg:col-span-3">
          <label class="block text-xs font-medium text-zinc-300 mb-1">
            Localização (Bairro, Cidade ou Estado)
          </label>
          <div class="relative">
            <input
              type="text"
              name="search[location_query]"
              value={@search_form["location_query"]}
              phx-keyup="suggest_locations"
              phx-debounce="300"
              autocomplete="off"
              placeholder="Digite um bairro ou cidade (ex: Moema, São Paulo)..."
              class="w-full rounded-lg bg-zinc-800/80 border border-zinc-700 text-white placeholder-zinc-500 pl-9 pr-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500"
            />
            <span class="absolute left-3 top-2 text-zinc-400 text-sm">📍</span>
          </div>

          <%= if @show_predictions && (@location_predictions != [] || !is_nil(@location_error)) do %>
            <div class="absolute z-50 left-0 right-0 mt-1 rounded-xl bg-zinc-900 border border-zinc-700 shadow-2xl overflow-hidden divide-y divide-zinc-800 max-h-60 overflow-y-auto">
              <%= if @location_error do %>
                <div class="p-3 text-xs text-amber-300 bg-amber-950/40 flex items-start gap-2">
                  <span class="text-sm">⚠️</span>
                  <div>{@location_error}</div>
                </div>
              <% end %>

              <%= for pred <- @location_predictions do %>
                <button
                  type="button"
                  phx-click="select_location"
                  phx-value-place-id={pred.place_id}
                  phx-value-description={pred.description}
                  class="w-full text-left px-4 py-2.5 text-xs text-zinc-200 hover:bg-indigo-600/30 hover:text-white flex items-center gap-2.5 transition"
                >
                  <span class="text-zinc-500">📍</span>
                  <div>
                    <div class="font-semibold text-white">{pred.main_text}</div>
                    <div class="text-[11px] text-zinc-400">{pred.secondary_text}</div>
                  </div>
                </button>
              <% end %>
            </div>
          <% end %>
        </div>

        <div>
          <label class="block text-xs font-medium text-zinc-300 mb-1">Tipo de Negócio</label>
          <select
            name="search[type]"
            class="w-full rounded-lg bg-zinc-800/80 border border-zinc-700 text-white px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500"
          >
            <option value="venda" selected={@search_form["type"] == "venda"}>
              Comprar (Venda)
            </option>
            <option value="aluguel" selected={@search_form["type"] == "aluguel"}>Alugar</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-zinc-300 mb-1">Preço Mínimo (R$)</label>
          <input
            type="number"
            name="search[min_price]"
            value={@search_form["min_price"]}
            placeholder="Ex: 200000"
            class="w-full rounded-lg bg-zinc-800/80 border border-zinc-700 text-white placeholder-zinc-500 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500"
          />
        </div>

        <div>
          <label class="block text-xs font-medium text-zinc-300 mb-1">Preço Máximo (R$)</label>
          <input
            type="number"
            name="search[max_price]"
            value={@search_form["max_price"]}
            placeholder="Ex: 800000"
            class="w-full rounded-lg bg-zinc-800/80 border border-zinc-700 text-white placeholder-zinc-500 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500"
          />
        </div>

        <div class="sm:col-span-2 lg:col-span-2">
          <label class="block text-xs font-medium text-zinc-300 mb-1">Mínimo de Quartos</label>
          <input
            type="number"
            name="search[bedrooms]"
            value={@search_form["bedrooms"]}
            placeholder="Ex: 2"
            class="w-full rounded-lg bg-zinc-800/80 border border-zinc-700 text-white placeholder-zinc-500 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500"
          />
        </div>
      </div>

      <div class="mt-5 flex justify-end">
        <button
          type="submit"
          disabled={@loading}
          class="inline-flex items-center gap-2 rounded-xl bg-orange-600 hover:bg-orange-500 px-6 py-2.5 text-sm font-semibold text-white shadow-lg shadow-orange-600/25 transition disabled:opacity-50"
        >
          <%= if @loading do %>
            <svg
              class="animate-spin h-4 w-4 text-white"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"
              >
              </circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
              >
              </path>
            </svg>
            Buscando Imóveis...
          <% else %>
            🔍 Buscar Imóveis
          <% end %>
        </button>
      </div>
    </form>
  </div>

  <%= if @error_message do %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700 mb-6 flex items-center gap-3">
      <span class="text-xl">⚠️</span>
      <div>{@error_message}</div>
    </div>
  <% end %>

  <%= if @searched && !@loading do %>
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-lg font-bold text-zinc-900">
        Resultados da Busca
      </h2>
      <span class="text-sm font-medium text-zinc-500">
        {@total} {if @total == 1, do: "imóvel encontrado", else: "imóveis encontrados"}
      </span>
    </div>

    <%= if @properties == [] && is_nil(@error_message) do %>
      <div class="text-center py-12 rounded-2xl border border-dashed border-zinc-300 p-8">
        <p class="text-zinc-500">Nenhum imóvel encontrado para esses filtros.</p>
      </div>
    <% else %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <%= for property <- @properties do %>
          <div class="group rounded-2xl border border-zinc-200 bg-white overflow-hidden shadow-sm hover:shadow-md transition">
            <div
              id={"carousel-#{property.external_id}"}
              phx-hook="CardCarousel"
              class="relative h-52 bg-zinc-900 overflow-hidden select-none"
            >
              <%= for {img_url, idx} <- Enum.with_index(property_images(property.images)) do %>
                <div
                  data-slide
                  class={"w-full h-full absolute inset-0 #{if idx == 0, do: "block", else: "hidden"}"}
                >
                  <img
                    src={img_url}
                    alt={"#{property.title} - Foto #{idx + 1}"}
                    referrerpolicy="no-referrer"
                    loading={if idx == 0, do: "eager", else: "lazy"}
                    onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=600&auto=format&fit=crop&q=80';"
                    class="w-full h-full object-cover transition duration-300"
                  />
                </div>
              <% end %>

              <div class="absolute top-3 right-3 z-30 bg-zinc-900/80 backdrop-blur-md text-white px-2.5 py-1 rounded-full text-xs font-bold shadow pointer-events-none">
                {format_price(property.price)}
              </div>
              <div class="absolute top-3 left-3 z-30 bg-orange-600 text-white px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider shadow pointer-events-none">
                OLX
              </div>

              <%= if length(property_images(property.images)) > 1 do %>
                <button
                  type="button"
                  data-action="prev"
                  aria-label="Foto anterior"
                  class="absolute left-2.5 top-1/2 -translate-y-1/2 z-30 w-7 h-7 rounded-full bg-zinc-900/60 hover:bg-zinc-900/90 text-white flex items-center justify-center backdrop-blur-sm shadow-md opacity-0 group-hover:opacity-100 focus:opacity-100 transition-all duration-200 hover:scale-110 active:scale-95"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-3.5 w-3.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2.5"
                      d="M15 19l-7-7 7-7"
                    />
                  </svg>
                </button>
                <button
                  type="button"
                  data-action="next"
                  aria-label="Próxima foto"
                  class="absolute right-2.5 top-1/2 -translate-y-1/2 z-30 w-7 h-7 rounded-full bg-zinc-900/60 hover:bg-zinc-900/90 text-white flex items-center justify-center backdrop-blur-sm shadow-md opacity-0 group-hover:opacity-100 focus:opacity-100 transition-all duration-200 hover:scale-110 active:scale-95"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-3.5 w-3.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2.5"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </button>

                <div class="absolute bottom-2.5 left-1/2 -translate-x-1/2 z-30 flex items-center gap-1.5 pointer-events-none drop-shadow">
                  <%= for idx <- 0..min(length(property_images(property.images)) - 1, 6) do %>
                    <span
                      data-bullet={idx}
                      class={"h-1.5 rounded-full transition-all duration-200 #{if idx == 0, do: "w-4 bg-white", else: "w-1.5 bg-white/60"}"}
                    >
                    </span>
                  <% end %>
                </div>

                <div class="absolute bottom-2.5 right-3 z-30 bg-zinc-900/70 backdrop-blur-md text-white text-[10px] font-semibold px-2 py-0.5 rounded-full shadow pointer-events-none">
                  📷 <span data-counter>1/{length(property_images(property.images))}</span>
                </div>
              <% end %>
            </div>

            <div class="p-5">
              <h3 class="text-sm font-bold text-zinc-900 line-clamp-2 mb-2 group-hover:text-indigo-600 transition">
                {property.title}
              </h3>

              <div class="text-xs text-zinc-500 mb-4 flex items-center gap-1">
                📍 {property.location.neighborhood || property.location.city ||
                  "Localização não informada"}
                <%= if property.location.state do %>
                  , {property.location.state}
                <% end %>
              </div>

              <div class="grid grid-cols-4 gap-2 pt-3 border-t border-zinc-100 text-center text-xs text-zinc-600 mb-4">
                <div>
                  <div class="font-bold text-zinc-900">{property.details.bedrooms || "-"}</div>
                  <div class="text-[10px] text-zinc-400">Quartos</div>
                </div>
                <div>
                  <div class="font-bold text-zinc-900">{property.details.bathrooms || "-"}</div>
                  <div class="text-[10px] text-zinc-400">Banh.</div>
                </div>
                <div>
                  <div class="font-bold text-zinc-900">
                    {property.details.garage_spaces || "-"}
                  </div>
                  <div class="text-[10px] text-zinc-400">Vagas</div>
                </div>
                <div>
                  <div class="font-bold text-zinc-900">
                    {if property.details.area_sqm, do: "#{property.details.area_sqm}m²", else: "-"}
                  </div>
                  <div class="text-[10px] text-zinc-400">Área</div>
                </div>
              </div>

              <%= if property.url != "" do %>
                <a
                  href={property.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block w-full text-center rounded-lg bg-zinc-100 hover:bg-zinc-200 py-2 text-xs font-semibold text-zinc-800 transition"
                >
                  Ver no site da OLX ↗
                </a>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
