<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8 rounded-2xl bg-gradient-to-r from-zinc-900 via-zinc-800 to-indigo-950 p-6 md:p-8 text-white shadow-xl">
    <div class="flex items-center gap-3 mb-2">
      <span class="inline-flex items-center rounded-md bg-indigo-500/20 px-2.5 py-1 text-xs font-semibold text-indigo-300 ring-1 ring-inset ring-indigo-500/30">
        Agregador Imobiliário
      </span>
      <span class="inline-flex items-center rounded-md bg-orange-500/20 px-2.5 py-1 text-xs font-semibold text-orange-300 ring-1 ring-inset ring-orange-500/30">
        Scraper OLX
      </span>
    </div>
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">
      Buscar Imóveis na OLX
    </h1>
    <p class="mt-2 max-w-2xl text-sm text-zinc-300">
      Filtre e extraia anúncios em tempo real diretamente da OLX via extração SSR de alta performance.
    </p>

    <form phx-submit="search" class="mt-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4">
        <div>
          <label class="block text-xs font-medium text-zinc-300 mb-1">Estado (UF)</label>
          <input
            type="text"
            name="search[state]"
            value={@search_form["state"]}
            placeholder="sp, rj, mg..."
            class="w-full rounded-lg bg-zinc-800/80 border border-zinc-700 text-white placeholder-zinc-500 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500"
          />
        </div>

        <div>
          <label class="block text-xs font-medium text-zinc-300 mb-1">Cidade (Slug)</label>
          <input
            type="text"
            name="search[city]"
            value={@search_form["city"]}
            placeholder="sao-paulo, campinas..."
            class="w-full rounded-lg bg-zinc-800/80 border border-zinc-700 text-white placeholder-zinc-500 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500"
          />
        </div>

        <div>
          <label class="block text-xs font-medium text-zinc-300 mb-1">Tipo</label>
          <select
            name="search[type]"
            class="w-full rounded-lg bg-zinc-800/80 border border-zinc-700 text-white px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500"
          >
            <option value="venda" selected={@search_form["type"] == "venda"}>Venda</option>
            <option value="aluguel" selected={@search_form["type"] == "aluguel"}>Aluguel</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-zinc-300 mb-1">Preço Mínimo (R$)</label>
          <input
            type="number"
            name="search[min_price]"
            value={@search_form["min_price"]}
            placeholder="Ex: 200000"
            class="w-full rounded-lg bg-zinc-800/80 border border-zinc-700 text-white placeholder-zinc-500 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500"
          />
        </div>

        <div>
          <label class="block text-xs font-medium text-zinc-300 mb-1">Preço Máximo (R$)</label>
          <input
            type="number"
            name="search[max_price]"
            value={@search_form["max_price"]}
            placeholder="Ex: 800000"
            class="w-full rounded-lg bg-zinc-800/80 border border-zinc-700 text-white placeholder-zinc-500 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500"
          />
        </div>

        <div>
          <label class="block text-xs font-medium text-zinc-300 mb-1">Mín. Quartos</label>
          <input
            type="number"
            name="search[bedrooms]"
            value={@search_form["bedrooms"]}
            placeholder="Ex: 2"
            class="w-full rounded-lg bg-zinc-800/80 border border-zinc-700 text-white placeholder-zinc-500 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500"
          />
        </div>
      </div>

      <div class="mt-5 flex justify-end">
        <button
          type="submit"
          disabled={@loading}
          class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-lg hover:bg-indigo-500 transition disabled:opacity-50"
        >
          <%= if @loading do %>
            <svg
              class="animate-spin h-4 w-4 text-white"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"
              >
              </circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
              >
              </path>
            </svg>
            Buscando Imóveis...
          <% else %>
            🔍 Buscar na OLX
          <% end %>
        </button>
      </div>
    </form>
  </div>

  <%= if @error_message do %>
    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700 mb-6 flex items-center gap-3">
      <span class="text-xl">⚠️</span>
      <div>{@error_message}</div>
    </div>
  <% end %>

  <%= if @searched && !@loading do %>
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-lg font-bold text-zinc-900">
        Resultados da Busca
      </h2>
      <span class="text-sm font-medium text-zinc-500">
        {@total} {if @total == 1, do: "imóvel encontrado", else: "imóveis encontrados"}
      </span>
    </div>

    <%= if @properties == [] && is_nil(@error_message) do %>
      <div class="text-center py-12 rounded-2xl border border-dashed border-zinc-300 p-8">
        <p class="text-zinc-500">Nenhum imóvel encontrado para esses filtros.</p>
      </div>
    <% else %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <%= for property <- @properties do %>
          <div class="group rounded-2xl border border-zinc-200 bg-white overflow-hidden shadow-sm hover:shadow-md transition">
            <div class="relative h-48 bg-zinc-100 overflow-hidden">
              <img
                src={first_image(property.images)}
                alt={property.title}
                class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
              />
              <div class="absolute top-3 right-3 bg-zinc-900/80 backdrop-blur-md text-white px-2.5 py-1 rounded-full text-xs font-bold shadow">
                {format_price(property.price)}
              </div>
              <div class="absolute top-3 left-3 bg-orange-600 text-white px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider">
                OLX
              </div>
            </div>

            <div class="p-5">
              <h3 class="text-sm font-bold text-zinc-900 line-clamp-2 mb-2 group-hover:text-indigo-600 transition">
                {property.title}
              </h3>

              <div class="text-xs text-zinc-500 mb-4 flex items-center gap-1">
                📍 {property.location.neighborhood || property.location.city ||
                  "Localização não informada"}
                <%= if property.location.state do %>
                  , {property.location.state}
                <% end %>
              </div>

              <div class="grid grid-cols-4 gap-2 pt-3 border-t border-zinc-100 text-center text-xs text-zinc-600 mb-4">
                <div>
                  <div class="font-bold text-zinc-900">{property.details.bedrooms || "-"}</div>
                  <div class="text-[10px] text-zinc-400">Quartos</div>
                </div>
                <div>
                  <div class="font-bold text-zinc-900">{property.details.bathrooms || "-"}</div>
                  <div class="text-[10px] text-zinc-400">Banh.</div>
                </div>
                <div>
                  <div class="font-bold text-zinc-900">
                    {property.details.garage_spaces || "-"}
                  </div>
                  <div class="text-[10px] text-zinc-400">Vagas</div>
                </div>
                <div>
                  <div class="font-bold text-zinc-900">
                    {if property.details.area_sqm, do: "#{property.details.area_sqm}m²", else: "-"}
                  </div>
                  <div class="text-[10px] text-zinc-400">Área</div>
                </div>
              </div>

              <%= if property.url != "" do %>
                <a
                  href={property.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block w-full text-center rounded-lg bg-zinc-100 hover:bg-zinc-200 py-2 text-xs font-semibold text-zinc-800 transition"
                >
                  Ver no site da OLX ↗
                </a>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
