<div
  id="property-search-root"
  phx-hook="SearchPersistence"
  class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8 py-8"
>
  <div class="mb-10 rounded-3xl bg-gradient-to-br from-zinc-900 via-zinc-900/95 to-zinc-950 p-6 sm:p-8 text-white shadow-2xl border border-zinc-800/80">
    <div class="flex items-center gap-3 mb-4">
      <div class="flex items-center justify-center w-12 h-12 rounded-2xl bg-gradient-to-tr from-amber-500 to-orange-500 text-white shadow-lg shadow-orange-500/25">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-6 h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
          />
        </svg>
      </div>
      <div>
        <span class="text-2xl font-black tracking-tight text-white flex items-center gap-1">
          Kfofo<span class="text-orange-500 text-3xl leading-none">.</span>
        </span>
        <p class="text-xs font-medium text-zinc-400">O seu agregador inteligente de lares</p>
      </div>
    </div>

    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-white">
      Encontre o seu cantinho ideal
    </h1>
    <p class="mt-2 max-w-2xl text-sm text-zinc-300">
      Pesquise e compare imóveis para morar ou investir nos principais portais do Brasil em uma única experiência.
    </p>

    <form phx-submit="search" class="mt-7">
      <input type="hidden" name="search[state]" value={@search_form["state"]} />
      <input type="hidden" name="search[city]" value={@search_form["city"]} />
      <input type="hidden" name="search[neighborhood]" value={@search_form["neighborhood"]} />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4">
        <div
          id="location-autocomplete-container"
          phx-hook="LocationAutocomplete"
          class="relative sm:col-span-2 lg:col-span-3"
        >
          <label class="block text-xs font-medium text-zinc-300 mb-1.5">
            Localização (Bairro, Cidade ou Estado)
          </label>
          <div class="relative">
            <input
              type="text"
              name="search[location_query]"
              value={@search_form["location_query"]}
              autocomplete="off"
              placeholder="Digite um bairro ou cidade (ex: Moema, São Paulo)..."
              class="w-full rounded-xl bg-zinc-950/80 border border-zinc-700/80 text-white font-normal not-italic placeholder:italic placeholder:font-normal placeholder:text-zinc-500 pl-10 pr-4 py-2.5 text-sm focus:border-orange-500 focus:ring-orange-500 focus:outline-none transition shadow-inner"
            />
            <span class="absolute left-3.5 top-2.5 text-zinc-400 text-sm">📍</span>
          </div>

          <%= if @show_predictions && (@location_predictions != [] || !is_nil(@location_error)) do %>
            <div
              data-predictions-dropdown
              class="absolute z-50 left-0 right-0 mt-2 rounded-2xl bg-zinc-900 border border-zinc-700 shadow-2xl overflow-hidden divide-y divide-zinc-800 max-h-64 overflow-y-auto"
            >
              <%= if @location_error do %>
                <div class="p-3.5 text-xs text-amber-300 bg-amber-950/50 flex items-start gap-2.5">
                  <span class="text-base">⚠️</span>
                  <div>{@location_error}</div>
                </div>
              <% end %>

              <%= for pred <- @location_predictions do %>
                <button
                  type="button"
                  data-prediction-item
                  phx-click="select_location"
                  phx-value-place-id={pred.place_id}
                  phx-value-description={pred.description}
                  class="w-full text-left px-4 py-3 text-xs text-zinc-300 hover:bg-orange-500/20 hover:text-white hover:border-l-4 hover:border-orange-500 hover:!pl-5 flex items-center gap-3.5 transition-all duration-150 border-l-4 border-transparent group/item"
                >
                  <div class="flex items-center justify-center w-7 h-7 rounded-lg bg-zinc-800/80 text-zinc-400 group-hover/item:bg-orange-500/30 group-hover/item:text-orange-400 transition-colors flex-shrink-0">
                    📍
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="font-semibold text-zinc-100 group-hover/item:text-white truncate">
                      {pred.main_text}
                    </div>
                    <div class="text-[11px] text-zinc-400 group-hover/item:text-orange-200/80 truncate">
                      {pred.secondary_text}
                    </div>
                  </div>
                </button>
              <% end %>
            </div>
          <% end %>
        </div>

        <div>
          <label class="block text-xs font-medium text-zinc-300 mb-1.5">Tipo de Negócio</label>
          <select
            name="search[type]"
            class="w-full rounded-xl bg-zinc-950/80 border border-zinc-700/80 text-white font-normal not-italic px-3.5 py-2.5 text-sm focus:border-orange-500 focus:ring-orange-500 focus:outline-none transition"
          >
            <option value="venda" selected={@search_form["type"] == "venda"}>
              Comprar (Venda)
            </option>
            <option value="aluguel" selected={@search_form["type"] == "aluguel"}>Alugar</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-zinc-300 mb-1.5">Preço Mínimo (R$)</label>
          <input
            type="number"
            name="search[min_price]"
            value={@search_form["min_price"]}
            placeholder="Ex: 200000"
            class="w-full rounded-xl bg-zinc-950/80 border border-zinc-700/80 text-white font-normal not-italic placeholder:italic placeholder:font-normal placeholder:text-zinc-500 px-3.5 py-2.5 text-sm focus:border-orange-500 focus:ring-orange-500 focus:outline-none transition"
          />
        </div>

        <div>
          <label class="block text-xs font-medium text-zinc-300 mb-1.5">Preço Máximo (R$)</label>
          <input
            type="number"
            name="search[max_price]"
            value={@search_form["max_price"]}
            placeholder="Ex: 800000"
            class="w-full rounded-xl bg-zinc-950/80 border border-zinc-700/80 text-white font-normal not-italic placeholder:italic placeholder:font-normal placeholder:text-zinc-500 px-3.5 py-2.5 text-sm focus:border-orange-500 focus:ring-orange-500 focus:outline-none transition"
          />
        </div>

        <div class="sm:col-span-2 lg:col-span-2">
          <label class="block text-xs font-medium text-zinc-300 mb-1.5">Mínimo de Quartos</label>
          <input
            type="number"
            name="search[bedrooms]"
            value={@search_form["bedrooms"]}
            placeholder="Ex: 2"
            class="w-full rounded-xl bg-zinc-950/80 border border-zinc-700/80 text-white font-normal not-italic placeholder:italic placeholder:font-normal placeholder:text-zinc-500 px-3.5 py-2.5 text-sm focus:border-orange-500 focus:ring-orange-500 focus:outline-none transition"
          />
        </div>
      </div>

      <div class="mt-6 flex justify-end">
        <button
          type="submit"
          disabled={@loading}
          class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-orange-600 to-amber-600 hover:from-orange-500 hover:to-amber-500 px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-orange-600/30 transition disabled:opacity-50 active:scale-98"
        >
          <%= if @loading do %>
            <svg
              class="animate-spin h-4 w-4 text-white"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"
              >
              </circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
              >
              </path>
            </svg>
            Buscando Imóveis...
          <% else %>
            🔍 Buscar Imóveis
          <% end %>
        </button>
      </div>
    </form>
  </div>

  <%= if @error_message do %>
    <div class="rounded-2xl border border-red-500/30 bg-red-950/40 p-4 text-sm text-red-200 mb-8 flex items-center gap-3 shadow-lg">
      <span class="text-xl">⚠️</span>
      <div>{@error_message}</div>
    </div>
  <% end %>

  <%= if @searched && !@loading do %>
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-xl font-bold text-white tracking-tight">
        Resultados da Busca
      </h2>
      <span class="text-sm font-medium text-zinc-400">
        {@total} {if @total == 1, do: "imóvel encontrado", else: "imóveis encontrados"}
      </span>
    </div>

    <%= if @properties == [] && is_nil(@error_message) do %>
      <div class="text-center py-16 rounded-3xl border border-dashed border-zinc-800 bg-zinc-900/30 p-8">
        <p class="text-zinc-400 text-base">Nenhum imóvel encontrado para esses filtros.</p>
      </div>
    <% else %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <%= for property <- @properties do %>
          <div class="group rounded-3xl border border-zinc-800/80 bg-zinc-900/90 overflow-hidden shadow-xl hover:shadow-2xl hover:border-zinc-700 transition duration-300 flex flex-col justify-between">
            <div>
              <div
                id={"carousel-#{property.external_id}"}
                phx-hook="CardCarousel"
                class="relative h-64 sm:h-72 w-full bg-zinc-950 overflow-hidden select-none"
              >
                <!-- Sliding Track with all images pre-rendered -->
                <div
                  data-track
                  class="flex w-full h-full transition-transform duration-300 ease-out"
                  style="transform: translateX(0%);"
                >
                  <%= for {img_url, idx} <- Enum.with_index(property_images(property.images)) do %>
                    <div data-slide class="w-full h-full flex-shrink-0 relative">
                      <img
                        src={img_url}
                        alt={"#{property.title} - Foto #{idx + 1}"}
                        referrerpolicy="no-referrer"
                        loading="eager"
                        onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=800&auto=format&fit=crop&q=80';"
                        class="w-full h-full object-cover"
                      />
                    </div>
                  <% end %>
                </div>
                
<!-- Price Badge -->
                <div class="absolute top-3.5 right-3.5 z-20 bg-zinc-950/85 backdrop-blur-md text-white px-3.5 py-1.5 rounded-full text-sm font-bold shadow-lg border border-white/10 pointer-events-none">
                  {format_price(property.price)}
                </div>
                
<!-- Portal Badge -->
                <div class="absolute top-3.5 left-3.5 z-20 bg-orange-600 text-white px-3 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider shadow-md pointer-events-none">
                  OLX
                </div>

                <%= if length(property_images(property.images)) > 1 do %>
                  <!-- Navigation Buttons -->
                  <button
                    type="button"
                    data-action="prev"
                    aria-label="Foto anterior"
                    class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-9 h-9 rounded-full bg-zinc-900/75 hover:bg-zinc-900 text-white flex items-center justify-center backdrop-blur-sm shadow-lg opacity-0 group-hover:opacity-100 focus:opacity-100 transition-all duration-200 hover:scale-110 active:scale-95 border border-white/10"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M15 19l-7-7 7-7"
                      />
                    </svg>
                  </button>
                  <button
                    type="button"
                    data-action="next"
                    aria-label="Próxima foto"
                    class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-9 h-9 rounded-full bg-zinc-900/75 hover:bg-zinc-900 text-white flex items-center justify-center backdrop-blur-sm shadow-lg opacity-0 group-hover:opacity-100 focus:opacity-100 transition-all duration-200 hover:scale-110 active:scale-95 border border-white/10"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M9 5l7 7-7 7"
                      />
                    </svg>
                  </button>
                  
<!-- Indicators (Dots) -->
                  <div class="absolute bottom-3 inset-x-0 z-20 flex items-center justify-center gap-1.5 pointer-events-none drop-shadow">
                    <%= for idx <- 0..min(length(property_images(property.images)) - 1, 6) do %>
                      <span
                        data-bullet
                        class={"h-1.5 rounded-full transition-all duration-300 #{if idx == 0, do: "w-4 bg-white", else: "w-1.5 bg-white/50"}"}
                      >
                      </span>
                    <% end %>
                  </div>
                  
<!-- Counter -->
                  <div class="absolute bottom-3 right-3.5 z-20 bg-zinc-950/75 backdrop-blur-md text-white/90 text-[11px] font-medium px-2.5 py-0.5 rounded-full shadow border border-white/10 pointer-events-none">
                    📷 <span data-counter>1/{length(property_images(property.images))}</span>
                  </div>
                <% end %>
              </div>

              <div class="p-6">
                <h3 class="text-base font-bold text-white line-clamp-2 mb-2 group-hover:text-orange-400 transition">
                  {property.title}
                </h3>

                <div class="text-xs text-zinc-400 mb-5 flex items-center gap-1.5">
                  <span class="text-orange-400">📍</span>
                  <span>
                    {property.location.neighborhood || property.location.city ||
                      "Localização não informada"}
                    <%= if property.location.state do %>
                      , {property.location.state}
                    <% end %>
                  </span>
                </div>

                <div class="grid grid-cols-4 gap-2 py-3 border-y border-zinc-800/80 text-center text-xs text-zinc-300 mb-5 bg-zinc-950/40 rounded-xl">
                  <div>
                    <div class="font-bold text-white text-sm">
                      {property.details.bedrooms || "-"}
                    </div>
                    <div class="text-[10px] text-zinc-500">Quartos</div>
                  </div>
                  <div>
                    <div class="font-bold text-white text-sm">
                      {property.details.bathrooms || "-"}
                    </div>
                    <div class="text-[10px] text-zinc-500">Banh.</div>
                  </div>
                  <div>
                    <div class="font-bold text-white text-sm">
                      {property.details.garage_spaces || "-"}
                    </div>
                    <div class="text-[10px] text-zinc-500">Vagas</div>
                  </div>
                  <div>
                    <div class="font-bold text-white text-sm">
                      {if property.details.area_sqm,
                        do: "#{property.details.area_sqm}m²",
                        else: "-"}
                    </div>
                    <div class="text-[10px] text-zinc-500">Área</div>
                  </div>
                </div>
              </div>
            </div>

            <div class="px-6 pb-6 pt-0">
              <%= if property.url != "" do %>
                <a
                  href={property.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block w-full text-center rounded-xl bg-zinc-800 hover:bg-orange-600 hover:text-white py-2.5 text-xs font-semibold text-zinc-200 border border-zinc-700/60 transition shadow-sm"
                >
                  Ver no site da OLX ↗
                </a>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
